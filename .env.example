# Where your data lives (default ~/.gaam/gaam.db)
# GAAM_DB=/Users/you/.gaam/gaam.db
# GAAM_PORT=4777
# Require "Authorization: Bearer <token>" on /mcp
# GAAM_TOKEN=

# Jira Cloud: URL + email + API token. Jira Server/DC: URL + personal access token (no email).
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_TOKEN=
# JIRA_PROJECT=FOOD

# Git: comma-separated local repositories to read commits from
# GAAM_REPOS=/Users/you/development/frontend-platform,/Users/you/development/dastan
# GITLAB_URL=https://gitlab.company.com
# GITLAB_TOKEN=
# GITHUB_TOKEN=

# Claude API for the in-app assistant (Anthropic SDK; tool approvals, effort, costs).
# Without it the assistant uses Claude Code / Codex with your own logins.
# ANTHROPIC_API_KEY=

# Recall: local Ollama embeddings + embedded LanceDB; SQLite remains authoritative.
# Install the model once: ollama pull bge-m3
# GAAM_EMBEDDINGS_URL=http://127.0.0.1:11434
# GAAM_EMBEDDINGS_MODEL=bge-m3
# GAAM_SEMANTIC=0  # explicit keyword-only mode
# GAAM_VECTOR_PATH=/absolute/path/to/disposable/vector-index

# Optional Mem0/Graphiti sidecar; see docs/AI_MEMORY.md.
# No extraction/export occurs unless configured. Automatic extraction creates proposals only.
# GAAM_MEMORY_URL=http://127.0.0.1:4780
# GAAM_MEMORY_TOKEN=
# GAAM_MEMORY_AUTO=1

# Optional Langfuse metadata export (no message text or document bodies).
# LANGFUSE_BASE_URL=https://your-langfuse-instance
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Disable scheduled background jobs for scratch/test servers.
# GAAM_SCHEDULER=0
