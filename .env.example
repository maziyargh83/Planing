# Where your data lives (default ~/.gaam/gaam.db)
# GAAM_DB=/Users/you/.gaam/gaam.db
# GAAM_PORT=4777
# Require "Authorization: Bearer <token>" on /mcp
# GAAM_TOKEN=

# Jira Cloud: URL + email + API token. Jira Server/DC: URL + personal access token (no email).
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_TOKEN=
# JIRA_PROJECT=FOOD

# Git: comma-separated local repositories to read commits from
# GAAM_REPOS=/Users/you/development/frontend-platform,/Users/you/development/dastan
# GITLAB_URL=https://gitlab.company.com
# GITLAB_TOKEN=
# GITHUB_TOKEN=

# Claude API for the in-app assistant (Anthropic SDK; tool approvals, effort, costs).
# Without it the assistant uses Claude Code / Codex with your own logins.
# ANTHROPIC_API_KEY=
