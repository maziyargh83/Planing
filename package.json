{
  "name": "gaam",
  "version": "0.1.0",
  "private": true,
  "description": "گام — a personal planner and second brain your AI agents drive over MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "panda codegen && vite build && node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts",
    "server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server/main.ts",
    "web": "vite",
    "build": "panda codegen && vite build",
    "mcp": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/mcp/stdio.ts",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts' 'web/src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ark-ui/solid": "5.40.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@pandacss/dev": "1.12.2",
    "@types/node": "^24",
    "lucide-solid": "^1.70.0",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15"
  },
  "packageManager": "pnpm@11.9.0"
}
