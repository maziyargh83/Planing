{
  "name": "gaam",
  "version": "0.1.0",
  "private": true,
  "description": "گام — a personal planner and second brain your AI agents drive over MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "panda codegen && vite build && node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/transports/http/main.ts",
    "server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/transports/http/main.ts",
    "web": "vite",
    "build": "panda codegen && vite build",
    "mcp": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/transports/mcp/stdio.ts",
    "extension": "node --disable-warning=ExperimentalWarning scripts/build-extension.mjs",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts' 'web/src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p extension",
    "prepare": "panda codegen",
    "eval": "promptfoo eval --config evals/promptfooconfig.yaml --no-cache",
    "eval:semantic": "promptfoo eval --config evals/promptfoo.semantic.yaml --no-cache"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "^1.19.0",
    "@lancedb/lancedb": "^0.41.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ark-ui/solid": "5.40.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@pandacss/dev": "1.12.2",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/solid-query": "5.107.1",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-virtual": "3.13.53",
    "@types/node": "^24",
    "lucide-solid": "^1.70.0",
    "promptfoo": "^0.125.1",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15"
  },
  "packageManager": "pnpm@11.9.0"
}
